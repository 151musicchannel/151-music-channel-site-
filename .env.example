# Copier ce fichier en ".env" et remplir les valeurs.

# Port du serveur
PORT=8151

# Adresse publique du site (utilisée pour le sitemap, les liens canoniques et le partage)
SITE_URL=https://www.exemple.com

# "production" une fois en ligne : active la redirection HTTPS et le cache des fichiers
NODE_ENV=development

# Clé secrète du formulaire (une longue chaîne aléatoire)
FORM_SECRET=remplacer-par-une-longue-chaine-aleatoire

# Envoi des messages du formulaire de contact par e-mail.
# Sans SMTP_HOST, les messages sont enregistrés dans storage/messages.jsonl
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Adresse qui reçoit les messages (sinon : l'e-mail de data/site.json)
CONTACT_TO=
