# =========================================================
# Fichier .env du SERVEUR (à copier en /var/www/151-music-channel/.env)
# Ne jamais envoyer ce fichier par e-mail ni le publier.
# =========================================================

NODE_ENV=production
PORT=8151
HOST=127.0.0.1

# Adresse publique du site (sans / à la fin)
SITE_URL=https://VOTRE-DOMAINE.com

# Longue chaîne aléatoire. Sur le serveur :  openssl rand -hex 32
FORM_SECRET=

# Clé de streaming vMix. Sur le serveur :  echo "151-$(openssl rand -hex 8)"
# (différente de la clé utilisée en local)
DIRECT_CLE=

# Messages du formulaire de contact envoyés par e-mail
# (boîte mail OVHcloud : Web Cloud → E-mails ; serveur d'envoi ssl0.ovh.net)
SMTP_HOST=ssl0.ovh.net
SMTP_PORT=465
SMTP_USER=contact@VOTRE-DOMAINE.com
SMTP_PASS=
SMTP_FROM=contact@VOTRE-DOMAINE.com
CONTACT_TO=contact@VOTRE-DOMAINE.com
