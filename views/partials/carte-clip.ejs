<%
  const source = aide.plateforme(clip.lien);
%><article class="carte carte--clip">
  <div class="carte__media carte__media--video">
    <img src="<%= aide.miniatureClip(clip) %>" alt="Miniature du clip <%= clip.titre %>" loading="lazy" width="480" height="270">
    <span class="carte__lecture" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg></span>
  </div>
  <div class="carte__corps">
    <% if (clip.categorie) { %><p class="etiquette"><%= clip.categorie %></p><% } %>
    <h3 class="carte__titre"><%= clip.titre %></h3>
    <p class="carte__sous">
      <% if (clip.artiste && aide.nomArtiste(clip.artiste) !== clip.artiste) { %>
        <a href="/artistes/<%= clip.artiste %>"><%= aide.nomArtiste(clip.artiste) %></a>
      <% } else { %><%= clip.artiste %><% } %>
    </p>
    <% if (source) { %>
      <a class="bouton bouton--petit" href="<%= clip.lien %>" target="_blank" rel="noopener noreferrer">
        Voir sur <%= source %>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 3h7v7h-2V6.4l-9.3 9.3-1.4-1.4L17.6 5H14V3zM5 5h6v2H5v12h12v-6h2v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2z"/></svg>
        <span class="sr-only">(nouvel onglet)</span>
      </a>
    <% } else { %>
      <span class="bouton bouton--petit bouton--inactif">Lien bientôt disponible</span>
    <% } %>
  </div>
</article>
