<article class="carte carte--actu">
  <a href="/actualites/<%= article.slug %>" class="carte__lien-bloc">
    <div class="carte__media">
      <img src="<%= aide.image(article.image, 'actualite') %>" alt="" loading="lazy" width="640" height="360">
    </div>
    <div class="carte__corps">
      <p class="carte__meta">
        <% if (article.categorie) { %><span class="etiquette"><%= article.categorie %></span><% } %>
        <time datetime="<%= article.date %>"><%= aide.date(article.date) %></time>
      </p>
      <h3 class="carte__titre"><%= article.titre %></h3>
      <p class="carte__texte"><%= article.resume %></p>
      <span class="carte__plus">Lire l'article →</span>
    </div>
  </a>
</article>
